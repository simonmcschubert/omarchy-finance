<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Finance's lock (server.py, Lock): the system confirms it's you, with
     the fingerprint when one is set up, otherwise the password. setup
     installs this file in /usr/share/polkit-1/actions/. -->
<policyconfig>
  <vendor>Finance</vendor>
  <vendor_url>https://github.com/simonmcschubert/omarchy-finance</vendor_url>
  <action id="io.github.simonmcschubert.omarchy-finance.unlock">
    <description>Unlock Finance</description>
    <message>Unlock Finance</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
